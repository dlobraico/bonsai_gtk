# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Build GTK4 desktop applications with Bonsai"
maintainer: ["Dominick LoBraico"]
authors: ["Dominick LoBraico"]
license: "MIT"
homepage: "https://github.com/dlobraico/bonsai_gtk"
bug-reports: "https://github.com/dlobraico/bonsai_gtk/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.17" & >= "3.17"}
  "bonsai"
  "core"
  "ppx_jane"
  "virtual_dom"
  "ocgtk"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dlobraico/bonsai_gtk.git"
