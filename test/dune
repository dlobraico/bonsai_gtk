; Only `bonsai_gtk.vtree`, so that `dune build -p bonsai_gtk @runtest` -- what
; `opam install bonsai_gtk --with-test` runs -- resolves. Anything needing
; `Bonsai_gtk_test` belongs in `test/handle/`, which the other package owns.

(library
 (name bonsai_gtk_tests)
 (package bonsai_gtk)
 (libraries core bonsai_gtk.vtree expect_test_helpers_core)
 (inline_tests
  (flags
   ;; dune 3.22+ox passes `-source-tree-root ..` but this ppx_expect runtime
   ;; concatenates only the basename, so tests in a subdir fail to find their
   ;; source; `.` compensates.
   (-source-tree-root .)))
 (preprocess
  (pps ppx_jane ppx_expect bonsai.ppx_bonsai)))
