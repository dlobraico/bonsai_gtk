(executables
 (names
  live_patcher
  live_driver
  live_signals
  live_controls
  live_containers
  live_events
  live_controllers
  live_keyvals
  live_lists
  live_text
  live_embed)
 (libraries
  core
  bonsai
  bonsai_gtk
  bonsai_gtk.vtree
  virtual_dom.ui_effect
  ocgtk.gtk
  ocgtk.gdk
  ocgtk.gio
  ocgtk.common)
 (preprocess
  (pps ppx_jane bonsai.ppx_bonsai)))

; Live tests drive a real GTK display, so they run only under xvfb and only when
; explicitly asked for:
;   BONSAI_GTK_LIVE_TESTS=1 xvfb-run -a dune build @test/live/runtest -j 1
;
; `-j 1` because that one `xvfb-run` gives every executable below the same X
; display, and each of them presents a real toplevel. A window mapping on a
; display takes the input focus off whichever window held it, so a neighbour
; starting up mid-test is indistinguishable, to `live_controllers.ml`'s focus
; block, from the focus controller losing focus on its own -- an intermittent
; golden diff that reads as a regression in the controller. Without it, 1 run in
; 10 fails (3 in 7 on a loaded machine); with it, 0 in 15. scripts/ci.sh carries
; the rest of the measurements.
;
; Note that `-j 1` limits the whole invocation, so its measured 2 s cost is
; against a tree whose executables are already built -- which is true inside
; ci.sh and need not be true here. On a cold tree this serialises compiling and
; linking eleven executables as well as running them; `dune build @test/live` (or
; @all) first, then the line above. `(locks)` on the rules would not have that
; property, and is the fix on the backlog.

(rule
 (alias runtest)
 (enabled_if
  (= %{env:BONSAI_GTK_LIVE_TESTS=0} 1))
 (deps live_patcher.exe)
 (action
  (progn
   (with-stdout-to
    output_patcher.txt
    (run %{exe:live_patcher.exe}))
   (diff expected_patcher.txt output_patcher.txt))))

